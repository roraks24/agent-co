# Application environment (development | production)
APP_ENV=development

# Groq API Key (required for LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database Connection String
# Local Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/charito
# For local file-based testing without PostgreSQL:
# DATABASE_URL=sqlite:///./charito.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Security & CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
REQUIRE_WORKSPACE_AUTH=false
EXPOSE_VERBOSE_ERRORS=true
