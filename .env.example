# ─────────────────────────────────────────────────────────────────────────────
# Agent Co Environment Configuration Template (.env.example)
# Note: Use placeholder values only. Never commit real API keys or production secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Server and Runtime Settings
APP_ENV=development
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-deployment.vercel.app
CORS_ALLOW_CREDENTIALS=false
REQUIRE_WORKSPACE_AUTH=false
EXPOSE_VERBOSE_ERRORS=false

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider Credentials (Placeholders)
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_placeholder_groq_api_key_here
OPENAI_API_KEY=sk-placeholder_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-placeholder_anthropic_api_key_here
GEMINI_API_KEY=placeholder_google_gemini_api_key_here
DEEPSEEK_API_KEY=sk-placeholder_deepseek_api_key_here

# Tool API Credentials (Optional)
TAVILY_API_KEY=tvly-placeholder_tavily_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Adaptive API Selection Pipeline Settings
# ─────────────────────────────────────────────────────────────────────────────
ADAPTIVE_ROUTING_ENABLED=true
ADAPTIVE_DEFAULT_TIER=MEDIUM
ADAPTIVE_STRICT_TIER_ROUTING=true
ADAPTIVE_FALLBACK_MAX_RETRIES=3
ADAPTIVE_ENABLED_PROVIDERS=groq,openai,deepseek,local,anthropic,google

# Scoring Criteria Weights (sum to ~1.0)
ADAPTIVE_WEIGHT_TIER=0.35
ADAPTIVE_WEIGHT_CAPABILITY=0.20
ADAPTIVE_WEIGHT_CONTEXT=0.15
ADAPTIVE_WEIGHT_COST=0.15
ADAPTIVE_WEIGHT_LATENCY=0.10
ADAPTIVE_WEIGHT_HEALTH=0.05

# ─────────────────────────────────────────────────────────────────────────────
# Database-Backed Provider Configuration & Encryption Settings
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_PATH=data/agent_co.db
API_KEY_ENCRYPTION_SECRET=your_32_byte_or_random_secret_string_here
