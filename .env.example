# ==============================================================================
# Rorak AI + Agent Co Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / SQLAlchemy)
# ------------------------------------------------------------------------------
# Mode A: PostgreSQL in Docker, backend running on local host
# Local backend connects via localhost / 127.0.0.1:
DATABASE_URL=postgresql+psycopg://rorak:rorak_secret_dev@127.0.0.1:5432/rorak_db

# Mode B: Both PostgreSQL and backend running inside Docker Compose
# Containerized backend connects to service hostname 'db':
# DATABASE_URL=postgresql+psycopg://rorak:rorak_secret_dev@db:5432/rorak_db

# PostgreSQL Docker Container Configuration
POSTGRES_USER=rorak
POSTGRES_PASSWORD=rorak_secret_dev
POSTGRES_DB=rorak_db
POSTGRES_PORT=5432

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# LLM & Search API Keys
# ------------------------------------------------------------------------------
# Required for LangGraph task planning and reasoning
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Tavily API key for live web search and deep research
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: Custom User-Agent for Wikipedia REST API requests
# WIKI_USER_AGENT=MyApp/1.0 (https://example.com)

# Optional LLM Model Overrides
# GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# In production, set a strong cryptographically random 256-bit string
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Workspace Access Control (enforce authentication for workspace operations)
REQUIRE_WORKSPACE_AUTH=false
EXPOSE_VERBOSE_ERRORS=true
CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------------------------------
# Paths & Storage
# ------------------------------------------------------------------------------
WORKSPACES_DIR=./workspaces

# ------------------------------------------------------------------------------
# Adaptive API Selection Pipeline Settings
# ------------------------------------------------------------------------------
ADAPTIVE_ROUTING_ENABLED=true
ADAPTIVE_DEFAULT_TIER=MEDIUM
ADAPTIVE_STRICT_TIER_ROUTING=true
ADAPTIVE_FALLBACK_MAX_RETRIES=3
ADAPTIVE_ENABLED_PROVIDERS=groq,openai,deepseek,local,anthropic,google

# Scoring Criteria Weights (sum to ~1.0)
ADAPTIVE_WEIGHT_TIER=0.35
ADAPTIVE_WEIGHT_CAPABILITY=0.20
ADAPTIVE_WEIGHT_CONTEXT=0.15
ADAPTIVE_WEIGHT_COST=0.15
ADAPTIVE_WEIGHT_LATENCY=0.10
ADAPTIVE_WEIGHT_HEALTH=0.05
