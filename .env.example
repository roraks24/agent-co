# ==============================================================================
# Agent Co - Environment Configuration Example
# ==============================================================================

# LLM Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Application & Security Settings
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
REQUIRE_WORKSPACE_AUTH=false
EXPOSE_VERBOSE_ERRORS=true

# Search & Research Tools Configuration
# Wikipedia REST API configuration (User-Agent is required by Wikimedia etiquette)
WIKI_USER_AGENT=AgentCo/1.0 (https://github.com/roraks24/agent-co; contact@agentco.dev)
# Optional Wikipedia REST API / Access Token
WIKI_API_KEY=

# Optional Tavily API Key for premium search fallback
TAVILY_API_KEY=
